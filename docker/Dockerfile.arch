# This Dockerfile provides a clean Arch userspace for exercising setup.sh.

FROM archlinux:base

RUN pacman -Syu --noconfirm sudo && \
    pacman -Scc --noconfirm

# Create devuser and set up sudo access.
RUN useradd -m -s /bin/bash devuser && \
    usermod -aG wheel devuser && \
    echo "%wheel ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers && \
    echo "devuser ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers.d/devuser && \
    chmod 0440 /etc/sudoers.d/devuser && \
    rm -f /home/devuser/.bashrc /home/devuser/.profile /home/devuser/.bash_logout /home/devuser/.zshrc

USER devuser
WORKDIR /home/devuser

ENTRYPOINT ["tail", "-f", "/dev/null"]
