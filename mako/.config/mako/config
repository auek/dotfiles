sort=-time
layer=top
anchor=top-right

font=JetBrainsMono Nerd Font Mono 11
background-color=#343f44
text-color=#d3c6aa
width=360
height=120
outer-margin=8
margin=4
padding=12
border-size=1
border-color=#4f585e
border-radius=6
progress-color=over #a7c080

icons=1
max-icon-size=40
markup=1
actions=1
history=1
max-history=10
max-visible=5
default-timeout=7000
ignore-timeout=0
format=<b>%s</b>\n%b
text-alignment=left

on-button-left=invoke-default-action
on-button-middle=dismiss-all
on-button-right=dismiss
on-touch=dismiss

[urgency=low]
text-color=#859289
border-color=#4f585e
default-timeout=5000

[urgency=critical]
background-color=#514045
text-color=#d3c6aa
border-color=#e67e80
default-timeout=0
