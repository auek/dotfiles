sort=-time
layer=top
anchor=top-right

font=JetBrainsMono Nerd Font Mono 11
width=360
height=120
outer-margin=8
margin=4
padding=12
border-size=1
border-radius=6

icons=1
max-icon-size=40
markup=1
actions=1
history=1
max-history=10
max-visible=5
default-timeout=7000
ignore-timeout=0
format=<b>%s</b>\n%b
text-alignment=left

on-button-left=invoke-default-action
on-button-middle=dismiss-all
on-button-right=dismiss
on-touch=dismiss

include=~/.local/state/dotfiles/theme/current/mako.conf

[urgency=low]
default-timeout=5000

[urgency=critical]
default-timeout=0
