{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "WebFetch(*)",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "NotebookEdit",
      "mcp__playwright",
      "mcp__playwright-headed"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)"
    ],
    "ask": [
      "Bash(sudo *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(dd *)",
      "Bash(git push *)",
      "mcp__playwright__browser_evaluate",
      "mcp__playwright__browser_run_code",
      "mcp__playwright__browser_file_upload",
      "mcp__playwright-headed__browser_evaluate",
      "mcp__playwright-headed__browser_run_code",
      "mcp__playwright-headed__browser_file_upload"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/safe-rm-rf.sh",
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/safe-push.sh",
            "shell": "bash"
          }
        ]
      }
    ]
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  }
}
