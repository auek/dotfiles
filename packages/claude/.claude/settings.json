{
  "permissions": {
    "allow": [
      "Bash(*)",
      "WebFetch(*)",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "NotebookEdit"
    ],
    "ask": [
      "Bash(sudo *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(dd *)",
      "Bash(git push --force*)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "model": "sonnet",
  "effortLevel": "medium",
  "tui": "fullscreen",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    }
  }
}
