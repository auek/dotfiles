{
  "permissions": {
    "allow": [
      "Bash(*)",
      "WebFetch(*)",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "NotebookEdit",
      "mcp__playwright",
      "mcp__playwright-headed"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)"
    ],
    "ask": [
      "Bash(sudo *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(dd *)",
      "Bash(git push *)",
      "mcp__playwright__browser_evaluate",
      "mcp__playwright__browser_run_code",
      "mcp__playwright__browser_file_upload",
      "mcp__playwright-headed__browser_evaluate",
      "mcp__playwright-headed__browser_run_code",
      "mcp__playwright-headed__browser_file_upload"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/safe-rm-rf.sh",
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/safe-push.sh",
            "shell": "bash"
          }
        ]
      }
    ]
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "playwright": {
      "command": "sh",
      "args": [
        "-c",
        "exec npx -y @playwright/mcp@latest --executable-path /usr/bin/chromium --user-data-dir \"$HOME/.local/share/playwright-mcp/profile\" --user-agent \"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/157.0.0.0 Safari/537.36\" --headless"
      ]
    },
    "playwright-headed": {
      "command": "sh",
      "args": [
        "-c",
        "exec npx -y @playwright/mcp@latest --executable-path /usr/bin/chromium --user-data-dir \"$HOME/.local/share/playwright-mcp/profile\" --user-agent \"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/157.0.0.0 Safari/537.36\""
      ]
    }
  }
}
