{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      "target/**",
      ".cache/**"
    ]
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["sh", "-c", "exec npx -y @playwright/mcp@latest --executable-path /usr/bin/chromium --user-data-dir \"$HOME/.local/share/playwright-mcp/profile\" --user-agent \"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/157.0.0.0 Safari/537.36\" --headless"]
    },
    "playwright-headed": {
      "type": "local",
      "command": ["sh", "-c", "exec npx -y @playwright/mcp@latest --executable-path /usr/bin/chromium --user-data-dir \"$HOME/.local/share/playwright-mcp/profile\" --user-agent \"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/157.0.0.0 Safari/537.36\""]
    },
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "CONTEXT7_API_KEY": "{file:~/.secrets/context7-api-key}"
        }
      }
    }
  },
  "permission": {
    "playwright_*": "allow",
    "playwright-headed_*": "allow",
    "playwright_browser_evaluate": "ask",
    "playwright_browser_run_code": "ask",
    "playwright_browser_file_upload": "ask",
    "playwright-headed_browser_evaluate": "ask",
    "playwright-headed_browser_run_code": "ask",
    "playwright-headed_browser_file_upload": "ask",
    "external_directory": {
      "~/code/**": "allow",
      "~/vaults/main/**": "allow"
    },
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "sudo *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git add": "allow",
      "git add *": "allow",
      "git restore --staged *": "allow",
      "git switch": "allow",
      "git switch *": "allow",
      "git checkout": "allow",
      "git checkout *": "allow",
      "git commit": "allow",
      "git commit *": "allow",
      "git rebase": "deny",
      "git rebase *": "deny",
      "git push": "allow",
      "git push *": "allow",
      "git reset --hard": "deny",
      "git reset --hard *": "deny",
      "git clean": "deny",
      "git clean *": "deny",
      "git checkout -- *": "deny",
      "git restore --source *": "deny",
      "git branch -d *": "deny",
      "git branch -D *": "deny",
      "git tag -d *": "deny"
    }
  }
}
