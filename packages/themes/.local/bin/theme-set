#!/usr/bin/env bash

set -euo pipefail

themes_root="$HOME/.local/share/dotfiles/themes"
state_dir="$HOME/.local/state/dotfiles/theme"
current="$state_dir/current"

required_fragments=(
  foot.ini
  tmux.conf
  nvim.lua
  waybar.css
  hyprland.lua
  wofi.css
  mako.conf
  swaybg-color
  wallpaper-name
)

missing_fragments() {
  local dir="$1" fragment
  for fragment in "${required_fragments[@]}"; do
    [[ -r "$dir/$fragment" ]] || printf '%s\n' "$fragment"
  done
}

if (( $# == 0 )); then
  if [[ -L "$current" ]] \
    && theme_dir="$(readlink -f "$current")" \
    && [[ -d "$theme_dir" ]] \
    && [[ -z "$(missing_fragments "$theme_dir")" ]]; then
    basename "$theme_dir"
    exit 0
  fi
  printf 'No valid theme selected\n' >&2
  exit 1
fi

theme="$1"
if (( $# != 1 )) || [[ ! "$theme" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  printf 'Usage: theme-set <theme>\n' >&2
  exit 2
fi

theme_dir="$themes_root/$theme"
if [[ ! -d "$theme_dir" ]]; then
  printf 'Unknown theme: %s\n' "$theme" >&2
  exit 1
fi

missing="$(missing_fragments "$theme_dir")"
if [[ -n "$missing" ]]; then
  printf 'Incomplete theme: %s (missing: %s)\n' "$theme" "${missing//$'\n'/ }" >&2
  exit 1
fi

mkdir -p "$state_dir"
tmp_link="$state_dir/.current.tmp.$$"
ln -s "$theme_dir" "$tmp_link"
mv -T "$tmp_link" "$current"

if command -v tmux >/dev/null 2>&1 && tmux info >/dev/null 2>&1; then
  tmux source-file "$theme_dir/tmux.conf" \
    || printf 'warning: could not reload tmux\n' >&2
fi

if command -v pkill >/dev/null 2>&1 && pgrep -x waybar >/dev/null 2>&1; then
  pkill -SIGUSR2 -x waybar \
    || printf 'warning: could not reload waybar\n' >&2
fi

if command -v makoctl >/dev/null 2>&1; then
  makoctl reload >/dev/null 2>&1 \
    || printf 'warning: could not reload mako\n' >&2
fi

if command -v hyprctl >/dev/null 2>&1 && hyprctl activeworkspace >/dev/null 2>&1; then
  hyprctl reload config-only >/dev/null \
    || printf 'warning: could not reload Hyprland\n' >&2
fi

if command -v systemctl >/dev/null 2>&1 \
  && systemctl --user is-active --quiet swaybg.service 2>/dev/null; then
  systemctl --user restart swaybg.service 2>/dev/null \
    || printf 'warning: could not restart swaybg\n' >&2
fi

if command -v foot-reload >/dev/null 2>&1; then
  foot-reload || printf 'warning: could not reload foot\n' >&2
fi

printf 'Theme switched to: %s\n' "$theme"
