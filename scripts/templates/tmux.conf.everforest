##### COLORSCHEME: $display_name
set-option -g status "on"
set-option -g status-style bg=#$background,fg=#$foreground
set-window-option -g window-status-style bg=#$surface,fg=#$tmux_panel_fg
set-window-option -g window-status-activity-style bg=#$tmux_activity_bg,fg=#$tmux_activity_fg
set-window-option -g window-status-current-style bg=#$tmux_current_bg,fg=#$tmux_current_fg
set-option -g pane-active-border-style fg=#$tmux_accent
set-option -g pane-border-style fg=#$tmux_border
set-option -g message-style bg=#$surface,fg=#$foreground
set-option -g message-command-style bg=#$surface,fg=#$foreground
set-option -g display-panes-active-colour "#$tmux_accent"
set-option -g display-panes-colour "#$tmux_border"
set-window-option -g clock-mode-colour "#$tmux_clock"
set-window-option -g window-status-bell-style bg=#$tmux_bell_bg,fg=#$tmux_bell_fg

# Explicit palette colours keep modes independent of tmux's built-in themes.
set-window-option -g mode-style bg=#$selection_background,fg=#$tmux_selection_fg
set-window-option -gq tree-mode-selection-style "#{E:mode-style}"
set-window-option -gq tree-mode-border-style bg=#$background,fg=#$tmux_border
set-window-option -gq tree-mode-preview-style "fg=#{?#{||:#{&&:#{pane_format},#{pane_active}},#{&&:#{window_format},#{window_active}}},#$tmux_accent,#$tmux_border}"
set-window-option -gq copy-mode-match-style bg=#$regular6,fg=#$background
set-window-option -gq copy-mode-current-match-style bg=#$regular5,fg=#$background
set-window-option -gq copy-mode-mark-style bg=#$warning,fg=#$background
set-window-option -gq copy-mode-line-number-style fg=#$muted
set-window-option -gq copy-mode-current-line-number-style fg=#$accent
set-window-option -gq switch-mode-match-style bg=#$regular6,fg=#$background
set-window-option -gq menu-style bg=#$surface,fg=#$foreground
set-window-option -gq menu-selected-style bg=#$selection_background,fg=#$tmux_selection_fg
set-window-option -gq menu-border-style bg=#$surface,fg=#$border
set-window-option -gq popup-style bg=#$surface,fg=#$foreground
set-window-option -gq popup-border-style bg=#$surface,fg=#$border
set-window-option -gq display-panes-border-style bg=#$background,fg=#$tmux_border
set-window-option -gq pane-scrollbars-style bg=#$surface,fg=#$muted
# The inside/outside fill format is only supported with tmux 3.8's tree styles.
if-shell -F '#{!=:#{tree-mode-selection-style},}' 'set-window-option -g fill-character "#{?is_inside,#[bg=#$background] ,#[fg=#$muted]#[acs]~}"'

set-option -g status-justify "left"
set-option -g status-left-style none
set-option -g status-left-length "80"
set-option -g status-right-style none
set-option -g status-right-length "80"
set-window-option -g window-status-separator ""

set-option -g status-left "#[bg=#$tmux_status_left_bg,fg=#$tmux_status_left_fg] #S #[bg=#$background,fg=#$tmux_status_left_bg,nobold,noitalics,nounderscore]"
set-option -g status-right "#[bg=#$background,fg=#$surface,nobold,nounderscore,noitalics]#[bg=#$surface,fg=#$tmux_status_right_text] %Y-%m-%d  %H:%M #[bg=#$surface,fg=#$tmux_status_right_mid,nobold,noitalics,nounderscore]#[bg=#$tmux_status_right_mid,fg=#$tmux_status_right_end] #h "
set-window-option -g window-status-current-format "#[bg=#$tmux_current_fmt_bg,fg=#$background,nobold,noitalics,nounderscore]#[bg=#$tmux_current_fmt_bg,fg=#$tmux_current_fmt_fg2] #I #[bg=#$tmux_current_fmt_bg,fg=#$tmux_current_fmt_fg3,bold] #W#{?window_zoomed_flag,*Z,} #[bg=#$background,fg=#$tmux_current_fmt_bg,nobold,noitalics,nounderscore]"
set-window-option -g window-status-format "#[bg=#$surface,fg=#$background,noitalics]#[bg=#$surface,fg=#{?window_bell_flag,#$urgent,#{?window_activity_flag,#$warning,#$muted}}] #I  #W #[bg=#$background,fg=#$surface,noitalics]"
